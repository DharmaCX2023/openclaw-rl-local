diff --git a/openrlhf/utils/loss_utils.py b/openrlhf/utils/loss_utils.py
index f4f67fd477b590bd0fb52b3042b36ee01c192db0..5f3abdc17781a6569c252a07e042ef9421a7ca89 100644
--- a/openrlhf/utils/loss_utils.py
+++ b/openrlhf/utils/loss_utils.py
@@ -4,6 +4,20 @@ import torch
 import torch.distributed as dist
 
 
+def full_grad_accum_micro_batches(num_micro_batches: int, accumulated_gradient: int) -> int:
+    """Return the largest prefix that ends on an optimizer-step boundary.
+
+    DeepSpeed keeps its gradient-accumulation counter across dataloader/epoch
+    boundaries. Consumers that compute normalization statistics one epoch at
+    a time must therefore avoid yielding a partial accumulation window at the
+    end of an epoch, or the normalization and optimizer-step windows diverge.
+    """
+    if num_micro_batches < 0:
+        raise ValueError(f"num_micro_batches must be non-negative, got {num_micro_batches}")
+    gas = max(int(accumulated_gradient), 1)
+    return num_micro_batches // gas * gas
+
+
 def _get_dp_group(strategy):
     if not dist.is_available() or not dist.is_initialized():
         return None
diff --git a/tests/test_distributed_sampler.py b/tests/test_distributed_sampler.py
new file mode 100644
index 0000000000000000000000000000000000000000..0e9f7a67aa0145cd32d0a7e8d70c267106012991
--- /dev/null
+++ b/tests/test_distributed_sampler.py
@@ -0,0 +1,51 @@
+import pytest
+import torch
+
+from openrlhf.utils.distributed_sampler import DistributedSampler
+
+
+def _rank_indices(dataset, lengths, rank, epoch=0):
+    sampler = DistributedSampler(
+        dataset,
+        num_replicas=2,
+        rank=rank,
+        shuffle=True,
+        seed=17,
+        drop_last=True,
+        lengths=lengths,
+        length_bucket_size=8,
+    )
+    sampler.set_epoch(epoch)
+    return list(sampler)
+
+
+def test_length_bucketing_preserves_membership_and_pairs_neighbor_lengths():
+    dataset = list(range(16))
+    lengths = [91, 3, 72, 18, 55, 44, 8, 63, 29, 80, 12, 37, 99, 24, 67, 48]
+    rank0 = _rank_indices(dataset, lengths, 0)
+    rank1 = _rank_indices(dataset, lengths, 1)
+
+    generator = torch.Generator().manual_seed(17)
+    shuffled = torch.randperm(len(dataset), generator=generator).tolist()
+    reconstructed = [item for pair in zip(rank0, rank1) for item in pair]
+
+    for start in range(0, len(dataset), 8):
+        expected = shuffled[start : start + 8]
+        actual = reconstructed[start : start + 8]
+        assert set(actual) == set(expected)
+        assert actual == sorted(actual, key=lengths.__getitem__)
+
+
+def test_length_bucketing_is_deterministic_per_epoch():
+    dataset = list(range(16))
+    lengths = list(reversed(range(16)))
+    assert _rank_indices(dataset, lengths, 0, epoch=2) == _rank_indices(dataset, lengths, 0, epoch=2)
+    assert _rank_indices(dataset, lengths, 0, epoch=2) != _rank_indices(dataset, lengths, 0, epoch=3)
+
+
+def test_length_bucketing_rejects_invalid_configuration():
+    dataset = list(range(8))
+    with pytest.raises(ValueError, match="dataset of size"):
+        DistributedSampler(dataset, num_replicas=2, rank=0, lengths=[1] * 7, length_bucket_size=8)
+    with pytest.raises(ValueError, match="divisible"):
+        DistributedSampler(dataset, num_replicas=3, rank=0, lengths=[1] * 8, length_bucket_size=8)
